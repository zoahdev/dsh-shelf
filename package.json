    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/shelf.test.mjs",
    "start": "node scripts/shelf.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "archive",
    "export",
    "lifecycle"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
